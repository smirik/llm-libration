# Environment variables for llm-libration package
# Copy this file to .env and fill in your actual values

# OpenAI API Key - required for LLM analysis
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# Optional: Custom model name (default: gpt-4-vision-preview)
# LLM_MODEL_NAME=gpt-4-vision-preview
# Optional: Temperature for LLM responses (default: 0.0 for deterministic results)
# LLM_TEMPERATURE=0.0
